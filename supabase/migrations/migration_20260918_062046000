-- ResolveIQ core schema: 13 business tables mirroring the original JPA entities.

create table customers (
  id            bigint generated by default as identity primary key,
  customer_code text not null unique,
  name          text not null,
  email         text not null unique,
  phone         text,
  status        text not null default 'ACTIVE',
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

create table products (
  id           bigint generated by default as identity primary key,
  product_code text not null unique,
  name         text not null,
  description  text,
  category     text,
  price        numeric(12,2),
  status       text not null default 'ACTIVE',
  created_at   timestamptz not null default now()
);

create table orders (
  id           bigint generated by default as identity primary key,
  order_code   text not null unique,
  customer_id  bigint not null references customers(id),
  product_id   bigint not null references products(id),
  quantity     integer,
  total_amount numeric(12,2),
  status       text not null default 'PLACED',
  order_date   timestamptz not null default now(),
  created_at   timestamptz not null default now()
);
create index orders_customer_id_idx on orders (customer_id);
create index orders_product_id_idx on orders (product_id);

create table payments (
  id                    bigint generated by default as identity primary key,
  payment_code          text not null unique,
  order_id              bigint not null references orders(id),
  amount                numeric(12,2) not null,
  payment_method        text,
  status                text not null default 'SUCCESS',
  transaction_reference text,
  payment_date          timestamptz not null default now(),
  created_at            timestamptz not null default now()
);
create index payments_order_id_idx on payments (order_id);

create table refunds (
  id               bigint generated by default as identity primary key,
  refund_code      text not null unique,
  payment_id       bigint not null references payments(id),
  amount           numeric(12,2) not null,
  status           text not null default 'PENDING',
  reason           text,
  refund_reference text,
  requested_at     timestamptz not null default now(),
  processed_at     timestamptz,
  created_at       timestamptz not null default now()
);
create index refunds_payment_id_idx on refunds (payment_id);

create table support_policies (
  id                         bigint generated by default as identity primary key,
  policy_code                text not null unique,
  policy_name                text not null,
  description                text,
  category                   text not null,
  maximum_auto_refund_amount numeric(12,2),
  auto_resolution_allowed    boolean not null default false,
  manager_approval_required  boolean not null default false,
  status                     text not null default 'ACTIVE',
  created_at                 timestamptz not null default now(),
  updated_at                 timestamptz not null default now()
);

create table support_tickets (
  id              bigint generated by default as identity primary key,
  case_id         text not null unique,
  customer_id     bigint not null references customers(id),
  category        text not null,
  order_reference text,
  subject         text not null,
  description     text not null,
  status          text not null default 'OPEN',
  created_at      timestamptz not null default now(),
  updated_at      timestamptz not null default now()
);
create index support_tickets_customer_id_idx on support_tickets (customer_id);

create table investigations (
  id                  bigint generated by default as identity primary key,
  investigation_code  text not null unique,
  ticket_id           bigint not null unique references support_tickets(id),
  status              text not null default 'PENDING',
  intent              text,
  sentiment           text,
  root_cause          text,
  confidence          numeric(4,3),
  risk_level          text,
  policy_check        text,
  authorization_check text,
  recommended_action  text,
  decision            text,
  customer_response   text,
  escalation_reason   text,
  started_at          timestamptz not null default now(),
  completed_at        timestamptz,
  created_at          timestamptz not null default now()
);

create table evidence (
  id               bigint generated by default as identity primary key,
  evidence_code    text not null unique,
  investigation_id bigint not null references investigations(id),
  evidence_type    text not null,
  source_type      text not null,
  source_reference text,
  description      text not null,
  relevance        text,
  created_at       timestamptz not null default now()
);
create index evidence_investigation_id_idx on evidence (investigation_id);

create table actions (
  id               bigint generated by default as identity primary key,
  action_code      text not null unique,
  investigation_id bigint not null references investigations(id),
  action_type      text not null,
  status           text not null default 'PENDING',
  description      text,
  performed_by     text,
  result           text,
  executed_at      timestamptz,
  created_at       timestamptz not null default now()
);
create index actions_investigation_id_idx on actions (investigation_id);

create table escalations (
  id               bigint generated by default as identity primary key,
  escalation_code  text not null unique,
  investigation_id bigint not null references investigations(id),
  reason           text not null,
  priority         text not null default 'MEDIUM',
  status           text not null default 'OPEN',
  assigned_to      text,
  handoff_summary  text,
  escalated_at     timestamptz not null default now(),
  resolved_at      timestamptz,
  created_at       timestamptz not null default now()
);
create index escalations_investigation_id_idx on escalations (investigation_id);

create table conversations (
  id          bigint generated by default as identity primary key,
  ticket_id   bigint not null references support_tickets(id),
  sender_type text not null,
  message     text not null,
  created_at  timestamptz not null default now()
);
create index conversations_ticket_id_idx on conversations (ticket_id);

create table audit_logs (
  id                bigint generated by default as identity primary key,
  audit_code        text not null unique,
  investigation_id  bigint references investigations(id),
  action_id         bigint references actions(id),
  escalation_id     bigint references escalations(id),
  event_type        text not null,
  actor_type        text not null,
  actor_reference   text,
  event_description text not null,
  created_at        timestamptz not null default now()
);
create index audit_logs_investigation_id_idx on audit_logs (investigation_id);
create index audit_logs_action_id_idx on audit_logs (action_id);
create index audit_logs_escalation_id_idx on audit_logs (escalation_id);

-- keep updated_at current (replaces JPA @PreUpdate)
create or replace function set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

create trigger customers_set_updated_at
  before update on customers
  for each row execute function set_updated_at();

create trigger support_tickets_set_updated_at
  before update on support_tickets
  for each row execute function set_updated_at();

create trigger support_policies_set_updated_at
  before update on support_policies
  for each row execute function set_updated_at();

-- Row level security on every table.
alter table customers        enable row level security;
alter table products         enable row level security;
alter table orders           enable row level security;
alter table payments         enable row level security;
alter table refunds          enable row level security;
alter table support_policies enable row level security;
alter table support_tickets  enable row level security;
alter table investigations   enable row level security;
alter table evidence         enable row level security;
alter table actions          enable row level security;
alter table escalations      enable row level security;
alter table conversations    enable row level security;
alter table audit_logs       enable row level security;

-- Public catalogue and policy text are readable.
grant select on products, support_policies to anon, authenticated;

create policy products_read on products
  for select to anon, authenticated using (true);

create policy support_policies_read on support_policies
  for select to anon, authenticated using (true);

-- Customer portal: read the case, its investigation status and thread; submit a case, reply to it.
grant select on support_tickets, investigations, conversations to anon, authenticated;
grant insert on support_tickets, conversations to anon, authenticated;

create policy support_tickets_read on support_tickets
  for select to anon, authenticated using (true);

create policy support_tickets_submit on support_tickets
  for insert to anon, authenticated with check (true);

create policy investigations_read on investigations
  for select to anon, authenticated using (true);

create policy conversations_read on conversations
  for select to anon, authenticated using (true);

create policy conversations_reply on conversations
  for insert to anon, authenticated with check (true);

-- customers, orders, payments, refunds, evidence, actions, escalations and
-- audit_logs intentionally have no client policy: they stay server-side only,
-- reachable through backend functions running with the service role.